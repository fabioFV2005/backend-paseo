{
  "name": "paseo-aranjuez-backend",
  "version": "0.1.0",
  "description": "Multi-store marketplace backend with loyalty program - Paseo Aranjuez",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
