GOOGLE_CLIENT_ID=tu-client-id-de-google.apps.googleusercontent.com

# Secreto de cliente OAuth 2.0 (Google Cloud Console -> Credenciales).
# SOLO backend: nunca lo expongas al navegador ni lo subas al repositorio.
GOOGLE_CLIENT_SECRET=tu-client-secret-de-google

# URI de redireccion autorizada en el cliente OAuth (opcional; este es el valor por defecto).
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# Clave para firmar la cookie de sesion de Flask (opcional; por defecto usa JWT_SECRET_KEY).
# FLASK_SECRET_KEY=

# Ponlo a 1 en produccion (HTTPS) para que la cookie de sesion sea Secure.
# SESSION_COOKIE_SECURE=0

JWT_SECRET_KEY=papayita

# Base de datos PostgreSQL (la tabla "users" se crea sola al arrancar la app).
DATABASE_URL=postgresql+psycopg://usuario:password@localhost:5432/hackaton
