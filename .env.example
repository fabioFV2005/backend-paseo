# ============================================================
# Paseo Aranjuez Backend - Environment variables example
# Copy this file to ".env" and fill in your real values:
#   cp .env.example .env
# ============================================================

# ----- Server -----
# Allowed values: development | test | production
NODE_ENV=development
PORT=4000

# ----- Database (PostgreSQL) -----
# With the local docker-compose.yml the port is 5440.
DB_HOST=localhost
DB_PORT=5440
DB_NAME=paseo_aranjuez
DB_USER=paseo
DB_PASSWORD=paseo123

# ----- Auth -----
# Long random string. Generate one with: openssl rand -hex 64
JWT_SECRET=change-me-to-a-long-random-string
# Token lifetime, any `ms` format: 1d, 12h, 3600...
JWT_EXPIRES_IN=1d

# ----- CORS -----
# Comma-separated whitelist of allowed frontend origins
CORS_ORIGIN=http://localhost:5173
