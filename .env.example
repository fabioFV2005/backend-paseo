# Copy to .env and fill in. .env is gitignored: never commit real secrets.
#
#   copy .env.example .env
#
# Generate SECRET_KEY and JWT_SECRET_KEY with, for example:
#   python -c "import secrets; print(secrets.token_hex(32))"

# --- Where the data lives ----------------------------------------------------

# PostgreSQL in development and demo; SQLite works too:
#   DATABASE_URL=sqlite+paseo_aranjuez.db
DATABASE_URL=postgresql+psycopg2://postgres:TU_CLAVE@localhost:5432/paseo_aranjuez

# --- Secrets -----------------------------------------------------------------

# Signs the session cookie. A different random value from the JWT key, so that
# leaking one does not leak the other.
SECRET_KEY=cambia-esto-por-64-caracteres-aleatorios

# Signs the JWTs the API hands to the frontend. If it is missing the app refuses
# to start rather than falling back to a guessable default.
JWT_SECRET_KEY=cambia-esto-por-64-caracteres-aleatorios

# --- Google OAuth (the only login method) ------------------------------------
# From Google Cloud Console -> APIs & Services -> Credentials -> OAuth client.
# Add http://localhost:5000/auth/google/callback as an authorised redirect URI.
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# Must match the URI registered in the console.
GOOGLE_REDIRECT_URI=http://localhost:5000/auth/google/callback

# --- Behaviour ---------------------------------------------------------------

# Set to 1 in production (HTTPS) so cookies are only sent over TLS.
# Leave it at 0 for local HTTP: with it on, the browser never sends the cookie
# back and every request looks unauthenticated.
SESSION_COOKIE_SECURE=0

# Origins allowed to call the API with credentials. Leave empty when the
# frontend is served from the same origin -- CORS is then not enabled at all,
# which is the safer default. Comma-separated, e.g. http://localhost:5173
CORS_ORIGINS=

# Where the rate limiter keeps its counters. memory:// is per-process, which is
# fine for one development server but wrong as soon as there are several
# workers: each keeps its own tally and the effective limit multiplies.
# Switch to Redis before running more than one process:
#   RATELIMIT_STORAGE_URI=redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://

# How long a shop must wait before crediting the SAME customer again at the same
# shop. Without it, a shop and a customer in collusion can scan the pair in a
# loop and mint an unlimited balance. The cost: two separate purchases by one
# customer at one shop inside this window are refused with a 409.
# Set to 0 to disable.
SCAN_DUPLICATE_WINDOW_SECONDS=60

# Set to "production" on the deployed server. It is the switch that makes the
# app refuse to fall back to a random secret, and that disables `flask dev-token`.
FLASK_ENV=

# SQLAlchemy query logging. Leave off; it prints every statement.
SQLALCHEMY_ECHO=0

# Never enable in production: it exposes the interactive debugger console.
FLASK_DEBUG=0

# Set to 1 only by the test suite, which overrides DATABASE_URL with SQLite.
TESTING=0
